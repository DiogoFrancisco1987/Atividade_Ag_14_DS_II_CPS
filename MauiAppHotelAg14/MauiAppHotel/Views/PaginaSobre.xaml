<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.PaginaSobre"
          
            
             BackgroundColor="{StaticResource Gray100}"
             >
    <VerticalStackLayout Padding="20" Spacing="20">
        
        <Label 
            FontFamily="Indie"
            FontSize="30"
            TextColor="Black"
            HorizontalOptions="Center"
            
            Text="Aplicativo feito com .Net Maui"
       
            />
        <Label 
          FontFamily="Indie"
          FontSize="30"
          TextColor="Black"
          HorizontalOptions="Center"
          
          Text="Desenvolvedor: Diogo"
     
          />
        
        <Label 
          FontFamily="Indie"
          FontSize="30"
          TextColor="Black"
          HorizontalOptions="Center"
          
          Text="Primeira versão 09/11/2026"
     
          />

        <Button Text="Voltar"
                Margin="0,30,0,0"
                BackgroundColor="Gray"
                TextColor="Black"
                Clicked="OnVoltarClicked"
                FontFamily="Indie"
FontAttributes="Bold"
FontSize="20"/>





    </VerticalStackLayout>
</ContentPage>