<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}"
             >
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10">
        <Label 
            Text="Cálculo da diária."
            FontFamily="Indie"
            FontSize="50"
            TextColor="{StaticResource Primary}"
       
            />

        <Frame Padding="10" BackgroundColor="Black">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*, *, 2*" > 
                    
                      <Label Grid.Row="0" Grid.Column="0"
                             Text="Adultos"
                             FontFamily="Indie"
                             FontSize="20"/>

                    <Label Grid.Row="0" Grid.Column="1"
                             TextColor="Yellow"
                             Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>
                    
                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"/>


                    <Label Grid.Row="1" Grid.Column="0"
                            Text="Crianças"
                           FontFamily="Indie"
                           FontSize="20"/>
                    


                    <Label Grid.Row="1" Grid.Column="1"
                            TextColor="Yellow"
                            Text="{Binding Value}"
                          BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                            x:Name="stp_criancas"
                            Minimum="0"
                            Maximum="10"
                            Increment="1"
                            
                             />

                </Grid>

                <Label Text="Escolha sua Suite"
                       FontFamily="Indie"
                       FontSize="20"/>

                <Picker x:Name="pck_quarto"
                        Title="Selecione sua acomadação"
                        ItemDisplayBinding="{Binding Descricao}"
                        FontFamily="Indie"
                        TextColor="White"
                        FontSize="20"/>


                <Frame Padding="10"
                       Margin="10" >

                    <VerticalStackLayout>
                        
                    <Label Text="Período de estadia"
                           FontFamily="Indie"
                           FontSize="20"/>


                        <HorizontalStackLayout>
                        <Label Text="Check-in:"
                               FontFamily="Indie"
                               FontSize="20"/>
                            <DatePicker x:Name="dtpck_checkin"
                                        Format="dd/MM/yyyy"
                                        BackgroundColor="CadetBlue"
                                        TextColor="Black"
                                        FontSize="20"
                                        DateSelected="dtpck_checkin_DateSelected"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <Label Text="Check-out:"
                                   FontFamily="Indie"
                                   FontSize="20"/>
                            <DatePicker x:Name="dtpck_checkout"
                                        TextColor="Black"
                                        Format="dd/MM/yyyy"
                                        BackgroundColor="Orange"
                                        FontSize="20"
                                       DateSelected="dtpck_checkout_DateSelected"/>
                        </HorizontalStackLayout>


                    </VerticalStackLayout>

                </Frame>

                <Button Text="Avançar"
                        Margin="0,0,0,10"
                        TextColor="Black"
                        BackgroundColor="Green"
                        Clicked="Button_Clicked" 
                        FontFamily="Indie"
                        FontAttributes="Bold"
                        FontSize="20"
                        />
                
                  

            </VerticalStackLayout>
            
        </Frame>

        <Button Text="Sobre" Margin="10,10,10,10"
           BackgroundColor="Grey"
           TextColor="Black"
           Clicked="OnSobreClicked"   
                FontFamily="Indie"
                FontAttributes="Bold"
                FontSize="20"
           />

    </VerticalStackLayout>

</ContentPage>